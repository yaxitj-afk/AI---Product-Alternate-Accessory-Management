<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_ai_email_generate_wizard_form" model="ir.ui.view">
        <field name="name">ai.email.generate.wizard.form</field>
        <field name="model">ai.email.generate.wizard</field>
        <field name="arch" type="xml">
            <form string="Generate Email Template using AI" class="o_ai_generate_wizard">

                <!-- ═══════════════════════════════════════════ -->
                <!--  HEADER BANNER                              -->
                <!-- ═══════════════════════════════════════════ -->
                <div class="o_ai_hero">
                    <div class="o_ai_hero_left">
                        <div class="o_ai_hero_icon">
                            <i class="fa fa-magic"/>
                        </div>
                        <div class="o_ai_hero_text">
                            <h2>AI Email Generator</h2>
                            <p>Describe your campaign and let AI do the heavy lifting.</p>
                        </div>
                    </div>
                    <!-- Active provider badge — computed field -->
                    <div class="o_ai_provider_badge">
                        <span class="o_ai_provider_label">Active Provider</span>
                        <span class="o_ai_provider_value">
                            <field name="active_provider_display" readonly="1" nolabel="1"/>
                        </span>
                    </div>
                </div>
                <div class="o_ai_progress_title">
                    <i class="fa fa-circle-o-notch fa-spin" invisible="state in ('done','failed')"/>
                    <i class="fa fa-check-circle" invisible="state != 'done'"/>
                    <i class="fa fa-exclamation-circle o_ai_error_icon" invisible="state != 'failed'"/>
                    <span invisible="state != 'done'">Template Generated Successfully!</span>
                    <span invisible="state != 'failed'">Generation Failed</span>
                    <span invisible="state in ('done','failed')">Generating your email template…</span>
                </div>
                <div class="o_ai_progress_note o_ai_error_note" invisible="state != 'failed'">
                    Something went wrong while generating the template. Please check your AI
                    provider configuration and try again.
                </div>

                <!-- hidden fields -->
                <field name="mailing_id" invisible="1"/>
                <field name="state" widget="ai_progress_tracker" invisible="1"/>

                <!-- ═══════════════════════════════════════════ -->
                <!--  INPUT SECTION  (visible only in draft)     -->
                <!-- ═══════════════════════════════════════════ -->
                <div class="o_ai_body" invisible="state != 'draft'">

                    <!-- PROMPT -->
                    <div class="o_ai_section">
                        <div class="o_ai_section_header">
                            <i class="fa fa-pencil-square-o"/>
                            <span>Campaign Prompt</span>
                        </div>
                        <field name="prompt"
                               nolabel="1"
                               placeholder="e.g. 30% off VIP exclusive sale for loyal customers, festive Diwali tone, include coupon code SAVE30, valid till 31 Oct"
                               class="o_ai_prompt_field"/>
                        <div class="o_ai_prompt_tips">
                            <span class="o_ai_tip_title">
                                <i class="fa fa-lightbulb-o"/>
                                Tips for a great prompt:
                            </span>
                            <ul class="o_ai_tip_list">
                                <li>Mention the <b>offer or purpose</b> (e.g. "30% off", "new product launch")
                                </li>
                                <li>Describe the <b>tone</b> (e.g. "festive", "professional", "friendly")
                                </li>
                                <li>Include <b>audience</b> context (e.g. "VIP members", "new subscribers")
                                </li>
                                <li>Add any <b>specific details</b> like coupon codes, dates, or product names
                                </li>
                            </ul>
                        </div>
                    </div>

                    <!-- GENERATION TYPE -->
                    <!-- GENERATION TYPE -->
                    <div class="o_ai_section">
                        <div class="o_ai_section_header">
                            <i class="fa fa-sliders"/>
                            <span>Generation Type</span>
                        </div>
                        <field name="output_type" nolabel="1" widget="ai_card_selector"/>
                    </div>

                </div>

                <!-- ═══════════════════════════════════════════ -->
                <!--  PROGRESS SECTION  (visible while running)  -->
                <!-- ═══════════════════════════════════════════ -->
                <div class="o_ai_progress_outer" invisible="state == 'draft'">

                    <div class="o_ai_progress_title">
                        <i class="fa fa-circle-o-notch fa-spin" invisible="state == 'done'"/>
                        <i class="fa fa-check-circle" invisible="state != 'done'"/>
                        <span invisible="state != 'done'">Template Generated Successfully!</span>
                        <span invisible="state == 'done'">Generating your email template…</span>
                    </div>

                    <div class="o_ai_stepper">

                        <!-- Step 1: Sending Request -->
                        <div class="o_ai_step"
                             invisible="state not in ('requesting','processing','generating','done')">
                            <div class="o_ai_step_circle o_ai_step_active"
                                 invisible="state != 'requesting'">
                                <i class="fa fa-spinner fa-spin"/>
                            </div>
                            <div class="o_ai_step_circle o_ai_step_done"
                                 invisible="state == 'requesting'">
                                <i class="fa fa-check"/>
                            </div>
                            <div class="o_ai_step_label">Sending Request</div>
                        </div>

                        <div class="o_ai_step_line"
                             invisible="state not in ('processing','generating','done')"/>

                        <!-- Step 2: Processing -->
                        <div class="o_ai_step"
                             invisible="state not in ('processing','generating','done')">
                            <div class="o_ai_step_circle o_ai_step_active"
                                 invisible="state != 'processing'">
                                <i class="fa fa-cog fa-spin"/>
                            </div>
                            <div class="o_ai_step_circle o_ai_step_done"
                                 invisible="state == 'processing'">
                                <i class="fa fa-check"/>
                            </div>
                            <div class="o_ai_step_label">Processing</div>
                        </div>

                        <div class="o_ai_step_line"
                             invisible="state not in ('generating','done')"/>

                        <!-- Step 3: Generating Content -->
                        <div class="o_ai_step"
                             invisible="state not in ('generating','done')">
                            <div class="o_ai_step_circle o_ai_step_active"
                                 invisible="state != 'generating'">
                                <i class="fa fa-paint-brush fa-spin"/>
                            </div>
                            <div class="o_ai_step_circle o_ai_step_done"
                                 invisible="state == 'generating'">
                                <i class="fa fa-check"/>
                            </div>
                            <div class="o_ai_step_label">Generating Content</div>
                        </div>

                        <div class="o_ai_step_line" invisible="state != 'done'"/>

                        <!-- Step 4: Done -->
                        <div class="o_ai_step" invisible="state != 'done'">
                            <div class="o_ai_step_circle o_ai_step_done">
                                <i class="fa fa-star"/>
                            </div>
                            <div class="o_ai_step_label">Done!</div>
                        </div>

                    </div>

                    <div class="o_ai_progress_note" invisible="state == 'done'">
                        This may take up to 30–60 seconds depending on the AI provider.
                        Please do not close this window.
                    </div>

                    <div class="o_ai_progress_note o_ai_success_note" invisible="state != 'done'">
                        Your template is ready. The window will close and show your updated mailing.
                    </div>

                </div>

                <!-- PREVIEW SECTION -->
                <div class="o_ai_preview_outer" invisible="state != 'preview'">
                    <div class="o_ai_preview_header">
                        <i class="fa fa-eye"/>
                        <b>Preview Generated Template</b>
                        <span class="o_ai_preview_hint">
                            Review below. Confirm to apply it to your mailing, or go back to regenerate.
                        </span>
                    </div>
                    <div class="o_ai_preview_frame_wrap">
                        <field name="preview_html" widget="html" nolabel="1" readonly="1"/>
                    </div>
                </div>

                <!-- DONE SECTION -->
                <div class="o_ai_done_outer" invisible="state != 'done'">
                    <i class="fa fa-check-circle" style="font-size:48px;color:#16A34A;"/>
                    <h3>Template Applied!</h3>
                    <p>Your mailing has been updated with the generated template.</p>
                </div>

                <!-- ═══════════════════════════════════════════ -->
                <!--  FOOTER BUTTONS                             -->
                <!-- ═══════════════════════════════════════════ -->
                <footer>
                    <button name="action_generate_template" type="object"
                            string="Generate Template" class="btn-primary"
                            invisible="state != 'draft'"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"
                            invisible="state != 'draft'"/>

                    <button name="action_confirm_template" type="object"
                            string="Apply to Mailing" class="btn-primary"
                            invisible="state != 'preview'"/>
                    <button name="action_regenerate" type="object"
                            string="Regenerate" class="btn-secondary"
                            invisible="state != 'preview'"/>
                    <button string="Cancel" special="cancel" class="btn-secondary"
                            invisible="state != 'preview'"/>

                    <button string="Close" special="cancel" class="btn-secondary"
                            invisible="state not in ('requesting','processing','generating','failed')"/>
                    <button string="Close" special="cancel" class="btn-primary"
                            invisible="state != 'done'"/>
                </footer>

            </form>
        </field>
    </record>

</odoo>
