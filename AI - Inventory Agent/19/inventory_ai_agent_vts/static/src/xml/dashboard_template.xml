<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="inventory_low_stock_dashboard_template"
       t-inherit="vraja_ai_dashboard_template"
       t-inherit-mode="extension">

        <xpath expr="//div[@id='dashboard_template_common_app_vts']" position="inside">
            <div t-if="state.store === 'ai_low_stock' &amp;&amp; !state.card"
                 class="d-flex justify-content-center align-items-center"
                 style="height:100vh;">
                <div class="text-center text-muted">
                    <span class="fa fa-spinner fa-spin fa-2x mb-3"/>
                    <div>Loading dashboard...</div>
                </div>
            </div>

            <div t-if="state.store === 'ai_low_stock' &amp;&amp; state.card" class="o_inventory_ai_dashboard_scroll">
                <t t-set="stats" t-value="getDashboardStats()"/>

                <h1 class="mb-4">AI Dashboard — Low Stock Replenishment</h1>

                <div t-if="state.isBusy" class="d-flex align-items-center gap-2 px-3 py-2 mb-3 rounded"
                     style="background:#fff8e1; border:1px solid #ffe082; color:#7a6000; width:fit-content;">
                    <span class="fa fa-spinner fa-spin" style="font-size:16px;"/>
                    <span style="font-size:14px; font-weight:500;">Please wait, processing...</span>
                </div>

                <div t-if="state.card.ai_low_stock_analysis_error"
                     class="alert alert-warning mb-3">
                    <span class="fa fa-exclamation-triangle me-2"/>
                    <t t-esc="state.card.ai_low_stock_analysis_error"/>
                </div>

                <!-- STATUS BAR -->
                <div class="d-flex align-items-center justify-content-between mb-4 p-3"
                     style="background:white; border-radius:10px; border:1px solid #dee2e6; box-shadow:0 1px 4px rgba(0,0,0,0.06);">
                    <div class="d-flex align-items-center gap-3">
                        <span class="fa fa-archive" style="font-size:1.6rem; color:#4472C4;"/>
                        <div>
                            <div class="fw-bold" style="font-size:15px; color:#2c3e7a;">
                                AI Low Stock Alert &amp; RFQ Automation
                            </div>
                            <div class="d-flex align-items-center gap-2 mt-1 flex-wrap">
                                <span style="color:#888;">Last Analyzed on |</span>
                                <span style="font-size:12px; color:#888;">
                                    <i class="fa fa-clock-o me-1"/>
                                    <t t-esc="stats.analyzedOn"/>
                                </span>
                            </div>
                        </div>
                    </div>
                    <div>
                        <span t-if="!state.card.ai_low_stock_attachment_id"
                              class="o_inventory_ai_status_badge o_inventory_ai_status_idle">
                            <i class="fa fa-minus-circle"/>No Data File
                        </span>
                        <span t-if="state.card.ai_low_stock_attachment_id and !state.card.ai_low_stock_analysis_result and !state.card.ai_low_stock_analysis_error"
                              class="o_inventory_ai_status_badge o_inventory_ai_status_ready">
                            <i class="fa fa-file-excel-o"/>Ready
                        </span>
                        <span t-if="state.card.ai_low_stock_analysis_result"
                              class="o_inventory_ai_status_badge o_inventory_ai_status_done">
                            <i class="fa fa-check-circle"/>Done
                        </span>
                        <span t-if="state.card.ai_low_stock_analysis_error"
                              class="o_inventory_ai_status_badge o_inventory_ai_status_error">
                            <i class="fa fa-exclamation-circle"/>Error
                        </span>
                    </div>
                </div>

                <!-- STEP 1 -->
                <div class="card mb-3 shadow-sm">
                    <div class="card-header d-flex justify-content-between align-items-center"
                         t-on-click="() => this.state.currentWizardStep = (this.state.currentWizardStep === 1 ? 0 : 1)"
                         style="cursor:pointer;">
                        <strong><span class="fa fa-info-circle me-2"/> About This Module</strong>
                        <i t-att-class="state.currentWizardStep === 1 ? 'fa fa-chevron-down toggle-icon' : 'fa fa-chevron-up toggle-icon'"/>
                    </div>
                    <div id="inventory_ai_step1_section" t-att-class="state.currentWizardStep === 1 ? 'collapse show' : 'collapse'">
                        <div class="card-body p-4">
                            <div class="mb-4">
                                <div style="font-size:20px; font-weight:700; margin-bottom:4px;">
                                    AI Low Stock Replenishment
                                </div>
                                <div style="font-size:13px; opacity:0.85;">
                                    Automate inventory forecasting, vendor selection and RFQ preparation inside Odoo.
                                </div>
                            </div>

                            <div class="row g-3 mb-4">
                                <div class="col-md-3">
                                    <div class="p-3 h-100 rounded text-center"
                                         style="background:#f0f4ff; border:1px solid #d0d9f5;">
                                        <div style="font-size:1.8rem; color:#4472C4; margin-bottom:8px;">
                                            <span class="fa fa-magic"/>
                                        </div>
                                        <div style="font-weight:600; font-size:13px; color:#2c3e7a; margin-bottom:4px;">AI Powered</div>
                                        <div class="text-muted" style="font-size:12px;">Uses stock, sales and purchase history to recommend replenishment.</div>
                                    </div>
                                </div>
                                <div class="col-md-3">
                                    <div class="p-3 h-100 rounded text-center"
                                         style="background:#f0fff4; border:1px solid #a3cfbb;">
                                        <div style="font-size:1.8rem; color:#27ae60; margin-bottom:8px;">
                                            <span class="fa fa-line-chart"/>
                                        </div>
                                        <div style="font-weight:600; font-size:13px; color:#1a6e3c; margin-bottom:4px;">Forecasting</div>
                                        <div class="text-muted" style="font-size:12px;">Forecasts demand from all history or a preferred recent period.</div>
                                    </div>
                                </div>
                                <div class="col-md-3">
                                    <div class="p-3 h-100 rounded text-center"
                                         style="background:#fff8f0; border:1px solid #f5cba7;">
                                        <div style="font-size:1.8rem; color:#e67e22; margin-bottom:8px;">
                                            <span class="fa fa-truck"/>
                                        </div>
                                        <div style="font-weight:600; font-size:13px; color:#935200; margin-bottom:4px;">Vendor Review</div>
                                        <div class="text-muted" style="font-size:12px;">Evaluates lead time, delays, reliability and purchase price.</div>
                                    </div>
                                </div>
                                <div class="col-md-3">
                                    <div class="p-3 h-100 rounded text-center"
                                         style="background:#fdf0ff; border:1px solid #e0b0f5;">
                                        <div style="font-size:1.8rem; color:#8e44ad; margin-bottom:8px;">
                                            <span class="fa fa-shopping-cart"/>
                                        </div>
                                        <div style="font-weight:600; font-size:13px; color:#5b2c7a; margin-bottom:4px;">RFQ Action</div>
                                        <div class="text-muted" style="font-size:12px;">Creates draft RFQs from approved AI replenishment rows.</div>
                                    </div>
                                </div>
                            </div>

                            <div class="mb-4">
                                <div class="fw-semibold mb-3" style="font-size:14px; color:#2c3e7a;">
                                    <span class="fa fa-list-ol me-2"/>How It Works
                                </div>
                                <div class="d-flex gap-2 flex-wrap">
                                    <div class="o_inventory_ai_step_chip"><span>1</span><em>Business Info</em></div>
                                    <div class="d-flex align-items-center" style="color:#ccc;"><span class="fa fa-chevron-right"/></div>
                                    <div class="o_inventory_ai_step_chip"><span>2</span><em>Configure Settings</em></div>
                                    <div class="d-flex align-items-center" style="color:#ccc;"><span class="fa fa-chevron-right"/></div>
                                    <div class="o_inventory_ai_step_chip"><span>3</span><em>Generate Data</em></div>
                                    <div class="d-flex align-items-center" style="color:#ccc;"><span class="fa fa-chevron-right"/></div>
                                    <div class="o_inventory_ai_step_chip"><span>4</span><em>Run AI</em></div>
                                    <div class="d-flex align-items-center" style="color:#ccc;"><span class="fa fa-chevron-right"/></div>
                                    <div class="o_inventory_ai_step_chip o_inventory_ai_step_chip_success"><span>5</span><em>Create RFQs</em></div>
                                </div>
                            </div>

                            <div class="d-flex align-items-start gap-3 p-3 rounded"
                                 style="background:#fffbe6; border:1px solid #ffe082;">
                                <span class="fa fa-lightbulb-o mt-1" style="color:#f0a500; font-size:16px;"/>
                                <div style="font-size:13px; color:#7a5800;">
                                    <strong>Tip:</strong>
                                    Keep business context and forecast periods accurate before generating the workbook. The AI reads those settings into its replenishment prompt.
                                </div>
                            </div>

                            <div class="d-flex justify-content-end mt-4">
                                <button class="btn btn-primary" t-on-click="onNextStep">Next <i class="fa fa-arrow-right ms-1"/></button>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- STEP 2 -->
                <div class="card mb-3 shadow-sm">
                    <div class="card-header d-flex justify-content-between align-items-center"
                         t-on-click="() => this.state.currentWizardStep = (this.state.currentWizardStep === 2 ? 0 : 2)"
                         style="cursor:pointer;">
                        <strong><span class="fa fa-building me-2"/> Company Information</strong>
                        <i t-att-class="state.currentWizardStep === 2 ? 'fa fa-chevron-down toggle-icon' : 'fa fa-chevron-up toggle-icon'"/>
                    </div>
                    <div id="inventory_ai_step2_section" t-att-class="state.currentWizardStep === 2 ? 'collapse show' : 'collapse'">
                        <div class="card-body p-4">
                            <div class="d-flex align-items-center gap-3 mb-4">
                                <div>
                                    <div style="font-size:15px; font-weight:700; color:#2c3e7a;">Inventory Business Context</div>
                                    <div class="text-muted" style="font-size:12px;">Help AI understand your warehouses, product types and replenishment rules.</div>
                                </div>
                            </div>

                            <div class="mb-3">
                                <label class="form-label fw-semibold" style="color:#2c3e7a; font-size:13px;">
                                    <span class="fa fa-pencil me-1"/>Describe Your Inventory Process
                                </label>
                                <textarea class="form-control" rows="5"
                                          style="font-size:13px; border:1px solid #d0d9f5; border-radius:8px; resize:vertical;"
                                          placeholder="e.g. We sell office furniture across two warehouses. Chairs and tables use preferred vendors with 7 day lead time. Keep at least 2 weeks stock for fast moving products..."
                                          t-on-input="(ev) => this.onChangeField('ai_low_stock_company_information', ev)"
                                          t-att-value="state.card.ai_low_stock_company_information || ''"/>
                            </div>
                            <div class="d-flex justify-content-between mt-4">
                                <button class="btn btn-outline-secondary" t-on-click="onPrevStep"><i class="fa fa-arrow-left me-1"/> Previous</button>
                                <button class="btn btn-primary" t-on-click="onNextStep">Next <i class="fa fa-arrow-right ms-1"/></button>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- STEP 3 -->
                <div class="card mb-3 shadow-sm">
                    <div class="card-header d-flex justify-content-between align-items-center"
                         t-on-click="() => this.state.currentWizardStep = (this.state.currentWizardStep === 3 ? 0 : 3)"
                         style="cursor:pointer;">
                        <strong><span class="fa fa-cog me-2"/> Forecast Configuration</strong>
                        <i t-att-class="state.currentWizardStep === 3 ? 'fa fa-chevron-down toggle-icon' : 'fa fa-chevron-up toggle-icon'"/>
                    </div>
                    <div id="inventory_ai_step3_section" t-att-class="state.currentWizardStep === 3 ? 'collapse show' : 'collapse'">
                        <div class="card-body p-4">
                            <div class="row g-4">
                                <div class="col-md-6">
                                    <div class="p-3 rounded h-100" style="background:#f8f9fa; border:1px solid #dee2e6;">
                                        <div class="fw-semibold mb-3" style="color:#2c3e7a; font-size:13px;">
                                            <span class="fa fa-sliders me-1"/>Forecast Settings
                                        </div>
                                        <div class="mb-3">
                                            <label class="form-label fw-semibold small">Minimum Stock Threshold</label>
                                            <input type="number" class="form-control form-control-sm" min="0"
                                                   t-on-input="(ev) => this.onChangeField('minimum_stock_threshold', ev)"
                                                   t-att-value="state.card.minimum_stock_threshold"/>
                                        </div>
                                        <div class="mb-3">
                                            <label class="form-label fw-semibold small">Sales Forecast Period</label>
                                            <select class="form-select form-select-sm"
                                                    t-on-change="(ev) => this.onChangeField('forecast_period', ev)"
                                                    t-att-value="state.card.forecast_period">
                                                <option value="all_data">All Time Data</option>
                                                <option value="selected_data">Preferred Data</option>
                                            </select>
                                        </div>
                                        <div class="mb-0" t-if="state.card.forecast_period === 'selected_data'">
                                            <label class="form-label fw-semibold small">Sales Forecast Days</label>
                                            <input type="number" class="form-control form-control-sm" min="1" max="365"
                                                   t-on-input="(ev) => this.onChangeField('sale_forecast_days', ev)"
                                                   t-att-value="state.card.sale_forecast_days"/>
                                        </div>
                                    </div>
                                </div>

                                <div class="col-md-6">
                                    <div class="p-3 rounded h-100" style="background:#f8f9fa; border:1px solid #dee2e6;">
                                        <div class="fw-semibold mb-3" style="color:#2c3e7a; font-size:13px;">
                                            <span class="fa fa-database me-1"/>Purchase &amp; RFQ Settings
                                        </div>
                                        <div class="mb-3">
                                            <label class="form-label fw-semibold small">Purchase Forecast Period</label>
                                            <select class="form-select form-select-sm"
                                                    t-on-change="(ev) => this.onChangeField('purchase_forecast_period', ev)"
                                                    t-att-value="state.card.purchase_forecast_period">
                                                <option value="all_data">All Purchase History</option>
                                                <option value="selected_data">Preferred Purchase Data</option>
                                            </select>
                                        </div>
                                        <div class="mb-3" t-if="state.card.purchase_forecast_period === 'selected_data'">
                                            <label class="form-label fw-semibold small">Purchase Forecast Days</label>
                                            <input type="number" class="form-control form-control-sm" min="1" max="365"
                                                   t-on-input="(ev) => this.onChangeField('purchase_forecast_days', ev)"
                                                   t-att-value="state.card.purchase_forecast_days"/>
                                        </div>
                                        <div class="form-check form-switch mb-0">
                                            <input class="form-check-input" type="checkbox"
                                                   id="ai_low_stock_auto_create_rfq"
                                                   t-on-change="(ev) => this.onChangeCheckbox('ai_low_stock_auto_create_rfq', ev)"
                                                   t-att-checked="state.card.ai_low_stock_auto_create_rfq"/>
                                            <label class="form-check-label small" for="ai_low_stock_auto_create_rfq">
                                                Auto create draft RFQs after AI analysis
                                            </label>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="d-flex justify-content-between align-items-center mt-4">
                                <button class="btn btn-outline-secondary" t-on-click="onPrevStep"><i class="fa fa-arrow-left me-1"/> Previous</button>
                                <div class="d-flex justify-content-end gap-2">
                                    <button class="btn btn-outline-primary"
                                            t-on-click="onClickGenerateFile"
                                            t-att-disabled="state.isBusy">
                                        <span class="fa fa-file-excel-o me-1"/>Save Data &amp; Next
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- STEP 4 -->
                <div class="card mb-3 shadow-sm">
                    <div class="card-header d-flex justify-content-between align-items-center"
                        t-on-click="() => this.state.currentWizardStep = (this.state.currentWizardStep === 4 ? 0 : 4)"
                        style="cursor:pointer;">
                        <strong><span class="fa fa-play me-2"/> Data File &amp; Run AI</strong>
                        <i t-att-class="state.currentWizardStep === 4 ? 'fa fa-chevron-down toggle-icon' : 'fa fa-chevron-up toggle-icon'"/>
                    </div>
                    <div id="inventory_ai_step4_section" t-att-class="state.currentWizardStep === 4 ? 'collapse show' : 'collapse'">
                        <div class="card-body p-4">
                            <div class="row g-4">
                                <div class="col-md-7">
                                    <div class="p-3 rounded h-100" style="background:#f8f9fa; border:1px solid #dee2e6;">
                                        <div class="fw-semibold mb-3" style="color:#2c3e7a; font-size:13px;">
                                            <span class="fa fa-file-excel-o me-1"/>Generated Workbook
                                        </div>
                                        <div t-if="state.card.ai_low_stock_attachment_id"
                                             class="d-flex align-items-center gap-3 p-3 rounded"
                                             style="background:white; border:1px solid #d0d9f5;">
                                            <span class="fa fa-file-excel-o text-success" style="font-size:2rem;"/>
                                            <div>
                                                <div class="fw-semibold"><t t-esc="state.card.stock_attachment_name"/></div>
                                                <div class="text-muted small">Stock, sales and purchase data prepared for AI analysis.</div>
                                            </div>
                                            <a t-att-href="'/web/content/' + state.card.ai_low_stock_attachment_id + '?download=true'"
                                               class="btn btn-outline-success btn-sm ms-auto">
                                                <span class="fa fa-download me-1"/>Download
                                            </a>
                                        </div>
                                        <div t-if="!state.card.ai_low_stock_attachment_id"
                                             class="d-flex align-items-center gap-2 p-3 rounded text-muted"
                                             style="background:white; border:1px dashed #d0d9f5; font-size:13px;">
                                            <span class="fa fa-info-circle"/>
                                            No workbook generated yet. Save settings in Step 3 first.
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-5">
                                    <div class="p-3 rounded h-100" style="background:#f0f4ff; border:1px solid #d0d9f5;">
                                        <div class="fw-semibold mb-2" style="color:#2c3e7a; font-size:13px;">
                                            <span class="fa fa-robot me-1"/>AI Analysis
                                        </div>
                                        <div class="text-muted mb-3" style="font-size:12px;">
                                            Run the replenishment analyst on the latest workbook and review RFQ recommendations in Step 5.
                                        </div>
<!--                                        <button class="btn btn-success w-100"-->
<!--                                                t-on-click="onClickRunAI"-->
<!--                                                t-att-disabled="state.isBusy || !state.card.ai_low_stock_attachment_id">-->
<!--                                            <span class="fa fa-play me-1"/>Run AI Analysis-->
<!--                                        </button>-->
                                    </div>
                                </div>
                            </div>
                            <div class="d-flex justify-content-between mt-4">
                                <button class="btn btn-outline-secondary" t-on-click="onPrevStep"><i class="fa fa-arrow-left me-1"/> Previous</button>
                                <button class="btn btn-success"
                                                t-on-click="onClickRunAI"
                                                t-att-disabled="state.isBusy || !state.card.ai_low_stock_attachment_id">
                                            <span class="fa fa-play me-1"/>Run AI Analysis
                                        </button>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- STEP 5 -->
                <div class="card mb-3 shadow-sm">
                    <div class="card-header d-flex justify-content-between align-items-center"
                         t-on-click="() => this.state.currentWizardStep = (this.state.currentWizardStep === 5 ? 0 : 5)"
                         style="cursor:pointer;">
                        <strong><span class="fa fa-table me-2"/> Review Results &amp; Create RFQs</strong>
                        <i t-att-class="state.currentWizardStep === 5 ? 'fa fa-chevron-down toggle-icon' : 'fa fa-chevron-up toggle-icon'"/>
                    </div>
                    <div id="inventory_ai_step5_section" t-att-class="state.currentWizardStep === 5 ? 'collapse show' : 'collapse'">
                        <div class="card-body p-4">
                            <div class="row g-3 mb-4">
                                <div class="col-md-4">
                                    <div class="p-3 rounded text-center" style="background:#f0f4ff; border:1px solid #d0d9f5;">
                                        <div class="fw-bold" style="font-size:22px; color:#4472C4;"><t t-esc="stats.recommendations"/></div>
                                        <div class="text-muted" style="font-size:12px;">Recommended Products</div>
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <div class="p-3 rounded text-center" style="background:#f0fff4; border:1px solid #a3cfbb;">
                                        <div class="fw-bold" style="font-size:22px; color:#27ae60;"><t t-esc="stats.totalQty"/></div>
                                        <div class="text-muted" style="font-size:12px;">Total Order Quantity</div>
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <div class="p-3 rounded text-center" style="background:#fff8f0; border:1px solid #f5cba7;">
                                        <div class="fw-bold" style="font-size:22px; color:#e67e22;"><t t-esc="stats.vendors"/></div>
                                        <div class="text-muted" style="font-size:12px;">Vendors</div>
                                    </div>
                                </div>
                            </div>

                            <div class="d-flex justify-content-between align-items-center gap-2 mb-3 flex-wrap">
                                <div class="fw-semibold" style="font-size:14px; color:#2c3e7a;">
                                    <span class="fa fa-list me-1"/>AI Replenishment Recommendations
                                </div>
                                <input type="text" class="form-control form-control-sm"
                                       style="max-width:360px;"
                                       placeholder="Search product, SKU, vendor..."
                                       t-on-input="onSearchProduct"/>
                            </div>

                            <div t-if="!state.card.ai_low_stock_analysis_result"
                                 class="d-flex align-items-center justify-content-center gap-2 text-muted rounded"
                                 style="min-height:180px; background:#f8f9fa; border:1px dashed #dee2e6; font-size:13px;">
                                <span class="fa fa-table"/>
                                No AI recommendations yet. Generate data and run AI analysis.
                            </div>

                            <div t-if="state.card.ai_low_stock_analysis_result">
                                <div style="max-height:520px; overflow:auto; border:1px solid #dee2e6; border-radius:8px;">
                                    <table class="table table-sm table-hover align-middle mb-0">
                                        <thead class="table-light sticky-top">
                                            <tr>
                                                <th>Product</th>
                                                <th>Vendor</th>
                                                <th class="text-end">Available</th>
                                                <th class="text-end">Forecast</th>
                                                <th class="text-end">Order Qty</th>
                                                <th>Decision</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <t t-foreach="getPaginatedLowStockResults()" t-as="record" t-key="`${record.product_id}-${record.recommended_vendor_id || record.recommended_vendor || ''}`">
                                                <tr>
                                                    <td>
                                                        <t t-if="record.product_sku">
                                                                [<t t-esc="record.product_sku"/>]
                                                        </t>
                                                        <t t-esc="record.product"/>
                                                    </td>
                                                    <td><t t-esc="record.recommended_vendor || '-'"/></td>
                                                    <td class="text-end"><t t-esc="record.available_stock"/></td>
                                                    <td class="text-end"><t t-esc="record.forecasted_demand"/></td>
                                                    <td class="text-end fw-semibold"><t t-esc="record.recommended_order_qty"/></td>
                                                    <td>
                                                        <span t-if="record.decision === 'CREATE_RFQ'" class="badge bg-success">Create RFQ</span>
                                                        <span t-if="record.decision !== 'CREATE_RFQ'" class="badge bg-secondary">No Action</span>
                                                    </td>
                                                </tr>
                                            </t>
                                        </tbody>
                                    </table>
                                </div>

                                <div class="d-flex justify-content-between align-items-center mt-3 flex-wrap gap-2">
                                    <div class="text-muted small">
                                        Showing <strong><t t-esc="getPaginatedLowStockResults().length"/></strong>
                                        of <strong><t t-esc="getFilteredProductAIResults().length"/></strong> products
                                    </div>
                                    <div class="d-flex gap-2 align-items-center">
                                        <button class="btn btn-outline-secondary btn-sm"
                                                t-on-click="onPrevPage"
                                                t-att-disabled="state.currentPage === 1">
                                            <span class="fa fa-chevron-left"/>
                                        </button>
                                        <span class="small fw-semibold">
                                            Page <t t-esc="state.currentPage || 1"/> / <t t-esc="getTotalPages()"/>
                                        </span>
                                        <button class="btn btn-outline-secondary btn-sm"
                                                t-on-click="onNextPage"
                                                t-att-disabled="(state.currentPage || 1) >= getTotalPages()">
                                            <span class="fa fa-chevron-right"/>
                                        </button>
                                    </div>
                                </div>
                            </div>
                            <div class="d-flex justify-content-between mt-4">
                                <button class="btn btn-outline-secondary" t-on-click="onPrevStep"><i class="fa fa-arrow-left me-1"/> Previous</button>
                                <button class="btn btn-success"
                                        t-on-click="onClickCreateRFQ"
                                        t-att-disabled="!state.card.ai_low_stock_analysis_result || !getParsedAIResult().length"
                                        t-attf-style="cursor: #{(!state.card.ai_low_stock_analysis_result || !getParsedAIResult().length) ? 'not-allowed' : 'pointer'}; pointer-events: auto;"
                                        t-att-title="(!state.card.ai_low_stock_analysis_result || !getParsedAIResult().length) ? 'No AI recommendations available to create RFQs.' : ''">
                                    <span class="fa fa-shopping-cart me-1"/>Create RFQs
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </xpath>
    </t>
</templates>
