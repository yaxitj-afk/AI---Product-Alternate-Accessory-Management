<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="vendor_ai_intelligence_dashboard_template"
       t-inherit="vraja_ai_dashboard_template"
       t-inherit-mode="extension">

        <xpath expr="//div[@id='dashboard_template_common_app_vts']" position="inside">
            <div t-if="state.store === 'ai_vendor_intel' &amp;&amp; !state.card"
                 class="d-flex justify-content-center align-items-center"
                 style="height:100vh;">
                <div class="text-center text-muted">
                    <span class="fa fa-spinner fa-spin fa-2x mb-3"/>
                    <div>Loading Vendor Intelligence Dashboard...</div>
                </div>
            </div>

            <div t-if="state.store === 'ai_vendor_intel' &amp;&amp; state.card"
                 style="height: 100vh; overflow-y: auto; overflow-x: hidden; padding-bottom: 30px;">

                <div t-if="state.card.ai_vendor_analysis_error"
                     class="alert alert-warning mb-3">
                    <span class="fa fa-exclamation-triangle me-2"/>
                    <t t-esc="state.card.ai_vendor_analysis_error"/>
                </div>

                <!-- STATUS BAR -->
                <div class="d-flex align-items-center justify-content-between mb-4 p-3"
                     style="background:white; border-radius:10px; border:1px solid #dee2e6; box-shadow:0 1px 4px rgba(0,0,0,0.06);">
                    <div class="d-flex align-items-center gap-3">
                        <span class="fa fa-handshake-o" style="font-size:1.6rem; color:#4472C4;"/>
                        <div>
                            <div class="fw-bold" style="font-size:15px; color:#2c3e7a;">
                                AI Vendor Intelligence &amp; Scoring
                            </div>
                            <div class="d-flex align-items-center gap-2 mt-1 flex-wrap">
                                <span style="color:#888;">Last Analyzed on |</span>
                                <span style="font-size:12px; color:#888;">
                                    <i class="fa fa-clock-o me-1"/>
                                    <t t-esc="state.card.ai_vendor_analyzed_on || 'Not analyzed yet'"/>
                                </span>
                            </div>
                        </div>
                    </div>
                    <div>
                        <span t-if="!state.card.ai_vendor_attachment_id"
                              class="o_vendor_ai_status_badge o_vendor_ai_status_idle">
                            <i class="fa fa-minus-circle"/>No Data File
                        </span>
                        <span t-if="state.card.ai_vendor_attachment_id and !state.card.ai_vendor_analysis_result and !state.card.ai_vendor_analysis_error"
                              class="o_vendor_ai_status_badge o_vendor_ai_status_ready">
                            <i class="fa fa-file-excel-o"/>Ready
                        </span>
                        <span t-if="state.card.ai_vendor_analysis_result"
                              class="o_vendor_ai_status_badge o_vendor_ai_status_done">
                            <i class="fa fa-check-circle"/>Done
                        </span>
                        <span t-if="state.card.ai_vendor_analysis_error"
                              class="o_vendor_ai_status_badge o_vendor_ai_status_error">
                            <i class="fa fa-exclamation-circle"/>Error
                        </span>
                    </div>
                </div>

                <div t-if="state.isBusy" class="d-flex align-items-center gap-2 px-3 py-2 mb-3 rounded"
                     style="background:#fff8e1; border:1px solid #ffe082; color:#7a6000; width:fit-content;">
                    <span class="fa fa-spinner fa-spin" style="font-size:16px;"/>
                    <span class="fw-semibold">Processing... Please wait</span>
                </div>

                <!-- STEP 1: ABOUT -->
                <div class="card mb-3 shadow-sm">
                    <div class="card-header d-flex justify-content-between align-items-center"
                         t-on-click="() => this.state.currentWizardStep = (this.state.currentWizardStep === 1 ? 0 : 1)"
                         style="cursor:pointer;">
                        <strong><span class="fa fa-info-circle me-2"/>
                            Step 1: About This Module</strong>
                        <i t-att-class="state.currentWizardStep === 1 ? 'fa fa-chevron-down toggle-icon' : 'fa fa-chevron-up toggle-icon'"/>
                    </div>
                    <div t-att-class="state.currentWizardStep === 1 ? 'collapse show' : 'collapse'">
                        <div class="card-body p-4">
                            <div class="mb-4">
                                <div style="font-size:20px; font-weight:700; margin-bottom:4px;">
                                    AI Vendor Scoring &amp; Recommendations
                                </div>
                                <div style="font-size:13px; opacity:0.85;">
                                    Automatically track vendor performance and let AI recommend the best suppliers.
                                </div>
                            </div>

                            <div class="row g-3 mb-4">
                                <div class="col-md-4">
                                    <div class="p-3 h-100 rounded text-center"
                                         style="background:#f0f4ff; border:1px solid #d0d9f5;">
                                        <div style="font-size:1.8rem; color:#4472C4; margin-bottom:8px;"><span class="fa fa-star-half-o"/></div>
                                        <div style="font-weight:600; font-size:13px; color:#2c3e7a;">Automated Scoring</div>
                                        <div class="text-muted" style="font-size:12px;">Grades vendors on delivery, fulfillment, and price based on historical POs.</div>
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <div class="p-3 h-100 rounded text-center"
                                         style="background:#e6f9f0; border:1px solid #b3e6cc;">
                                        <div style="font-size:1.8rem; color:#28a745; margin-bottom:8px;"><span class="fa fa-line-chart"/></div>
                                        <div style="font-weight:600; font-size:13px; color:#1a662a;">Risk Management</div>
                                        <div class="text-muted" style="font-size:12px;">Identifies reliable vs risky vendors to prevent supply chain disruptions.</div>
                                    </div>
                                </div>
                                <div class="col-md-4">
                                    <div class="p-3 h-100 rounded text-center"
                                         style="background:#fdf0ff; border:1px solid #e0b0f5;">
                                        <div style="font-size:1.8rem; color:#8e44ad; margin-bottom:8px;"><span class="fa fa-magic"/></div>
                                        <div style="font-weight:600; font-size:13px; color:#5b2c7a;">AI Recommendations</div>
                                        <div class="text-muted" style="font-size:12px;">Get smart supplier suggestions right when you create a Purchase Order.</div>
                                    </div>
                                </div>
                            </div>

                            <div class="d-flex align-items-start gap-3 p-3 rounded"
                                 style="background:#fffbe6; border:1px solid #ffe082;">
                                <span class="fa fa-lightbulb-o mt-1" style="color:#f0a500; font-size:16px;"/>
                                <div style="font-size:13px; color:#7a5800;">
                                    <strong>Tip:</strong>
                                    Keep business context and Purchase periods accurate before generating the workbook.
                                    The AI reads those settings into its vendor intelligence prompt.
                                </div>
                            </div>

                            <div class="d-flex justify-content-end mt-4">
                                <button class="btn btn-primary" t-on-click="onNextStep">Next <i
                                        class="fa fa-arrow-right ms-1"/></button>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- STEP 2: COMPANY INFORMATION -->
                <div class="card mb-3 shadow-sm">
                    <div class="card-header d-flex justify-content-between align-items-center"
                         t-on-click="() => this.state.currentWizardStep = (this.state.currentWizardStep === 2 ? 0 : 2)"
                         style="cursor:pointer;">
                        <strong><span class="fa fa-building me-2"/>
                            Step 2: Company Information</strong>
                        <i t-att-class="state.currentWizardStep === 2 ? 'fa fa-chevron-down toggle-icon' : 'fa fa-chevron-up toggle-icon'"/>
                    </div>
                    <div t-att-class="state.currentWizardStep === 2 ? 'collapse show' : 'collapse'">
                        <div class="card-body p-4">

                            <div class="mb-3">
                                <label class="form-label fw-semibold" style="color:#2c3e7a; font-size:13px;">
                                    <span class="fa fa-pencil me-1"/>Describe Your Company Details
                                </label>
                                <textarea class="form-control" rows="5"
                                          style="font-size:13px; border:1px solid #d0d9f5; border-radius:8px; resize:vertical;"
                                          placeholder="e.g. We are XYZ Ltd. We sell office furniture across two warehouses..."
                                          t-on-input="(ev) => this.onChangeField('ai_vendor_company_information', ev)"
                                          t-att-value="state.card.ai_vendor_company_information || ''"/>
                                <div class="form-text mt-2">Help the AI understand who you are and what your business does.</div>
                            </div>

                            <div class="d-flex justify-content-between mt-4">
                                <button class="btn btn-outline-secondary" t-on-click="onPrevStep"><i class="fa fa-arrow-left me-1"/>
                                    Previous</button>
                                <button class="btn btn-primary" t-on-click="onNextStep">Next <i
                                        class="fa fa-arrow-right ms-1"/></button>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- STEP 3: CONFIGURATION & GENERATE DATA -->
                <div class="card mb-3 shadow-sm">
                    <div class="card-header d-flex justify-content-between align-items-center"
                         t-on-click="() => this.state.currentWizardStep = (this.state.currentWizardStep === 3 ? 0 : 3)"
                         style="cursor:pointer;">
                        <strong><span class="fa fa-cog me-2"/>
                            Step 3: Forecast Configuration</strong>
                        <i t-att-class="state.currentWizardStep === 3 ? 'fa fa-chevron-down toggle-icon' : 'fa fa-chevron-up toggle-icon'"/>
                    </div>
                    <div t-att-class="state.currentWizardStep === 3 ? 'collapse show' : 'collapse'">
                        <div class="card-body p-4">
                            <div class="mb-4 p-3 rounded" style="background:#f8f9fa; border:1px solid #dee2e6;">
                                <label class="form-label fw-semibold" style="color:#2c3e7a; font-size:13px;">
                                    <span class="fa fa-pencil me-1"/>Describe Your Vendor &amp; Procurement Process
                                </label>
                                <textarea class="form-control" rows="3"
                                          style="font-size:13px; border:1px solid #d0d9f5; border-radius:8px; resize:vertical;"
                                          placeholder="e.g. We prioritize vendors with lead times under 7 days. Quality is more important than price for electronic components. We have preferred vendors for raw materials..."
                                          t-on-input="(ev) => this.onChangeField('ai_vendor_procurement_process', ev)"
                                          t-att-value="state.card.ai_vendor_procurement_process || ''"/>
                                <div class="form-text mt-2">Help the AI understand your specific procurement needs before making recommendations.</div>
                            </div>

                            <div class="row g-4">
                                <div class="col-md-6">
                                    <div class="p-3 rounded h-100"
                                         style="background:#f8f9fa; border:1px solid #dee2e6;">
                                        <div class="fw-semibold mb-3" style="color:#2c3e7a; font-size:13px;">
                                            <span class="fa fa-sliders me-1"/>Purchase Analysis Settings
                                        </div>
                                        <div class="mb-3">
                                            <label class="form-label fw-semibold small">Data Analysis Period</label>
                                            <select class="form-select form-select-sm"
                                                    t-on-change="(ev) => this.onChangeField('ai_vendor_forecast_period', ev)"
                                                    t-att-value="state.card.ai_vendor_forecast_period">
                                                <option value="all_data">All Time Data</option>
                                                <option value="selected_data">Preferred Data</option>
                                            </select>
                                        </div>
                                        <div class="mb-0"
                                             t-if="state.card.ai_vendor_forecast_period === 'selected_data'">
                                            <label class="form-label fw-semibold small">Analysis Days</label>
                                            <input type="number" class="form-control form-control-sm" min="1"
                                                   t-on-input="(ev) => this.onChangeField('ai_vendor_forecast_days', ev)"
                                                   t-att-value="state.card.ai_vendor_forecast_days"/>
                                            <div class="form-text">Look at purchase orders from the last X days.</div>
                                        </div>

                                        <!-- Auto Run AI Analysis Toggle -->
                                        <div class="mt-3 pt-3 border-top d-flex align-items-center justify-content-between">
                                            <div>
                                                <div class="fw-semibold small">Auto Run AI Analysis</div>
                                                <div class="form-text mt-0">When enabled, the scheduled cron will automatically call OpenAI API.</div>
                                            </div>
                                            <div class="form-check form-switch ms-3">
                                                <input class="form-check-input" type="checkbox" role="switch"
                                                       id="autoRunAIToggle"
                                                       t-att-checked="state.card.ai_vendor_auto_analyze"
                                                       t-on-change="(ev) => this.onChangeBooleanField('ai_vendor_auto_analyze', ev)"/>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <div class="col-md-6">
                                    <div class="p-3 rounded h-100"
                                         style="background:#f8f9fa; border:1px solid #dee2e6;">
                                        <div class="fw-semibold mb-3" style="color:#2c3e7a; font-size:13px;">
                                            <span class="fa fa-info-circle me-1"/>What Gets Generated
                                        </div>
                                        <ul class="list-unstyled mb-0" style="font-size:13px;">
                                            <li class="mb-2"><span class="fa fa-check text-success me-2"/>Vendor
                                                performance scores (Delivery, Fulfillment, Price, Lead Time)</li>
                                            <li class="mb-2"><span class="fa fa-check text-success me-2"/>Historical
                                                purchase orders with SKU-level detail</li>
                                            <li class="mb-2"><span class="fa fa-check text-success me-2"/>Category-level
                                                vendor breakdown</li>
                                            <li class="mb-0"><span class="fa fa-check text-success me-2"/>Packaged as a
                                                single Excel workbook for AI analysis</li>
                                        </ul>
                                    </div>
                                </div>
                            </div>

                            <div class="d-flex justify-content-between align-items-center mt-4">
                                <button class="btn btn-outline-secondary" t-on-click="onPrevStep"><i class="fa fa-arrow-left me-1"/>
                                    Previous</button>
                                <button class="btn btn-outline-primary"
                                        t-on-click="onClickGenerateData"
                                        t-att-disabled="state.isBusy">
                                    <span class="fa fa-file-excel-o me-1"/>
                                    Save Data
                                </button>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- STEP 4: RUN AI -->
                <div class="card mb-3 shadow-sm">
                    <div class="card-header d-flex justify-content-between align-items-center"
                         t-on-click="() => this.state.currentWizardStep = (this.state.currentWizardStep === 4 ? 0 : 4)"
                         style="cursor:pointer;">
                        <strong><span class="fa fa-play me-2"/>
                            Step 4: Data File &amp; Run AI</strong>
                        <i t-att-class="state.currentWizardStep === 4 ? 'fa fa-chevron-down toggle-icon' : 'fa fa-chevron-up toggle-icon'"/>
                    </div>
                    <div t-att-class="state.currentWizardStep === 4 ? 'collapse show' : 'collapse'">
                        <div class="card-body p-4">
                            <div class="row g-4">
                                <div class="col-md-7">
                                    <div class="p-3 rounded h-100"
                                         style="background:#f8f9fa; border:1px solid #dee2e6;">
                                        <div class="fw-semibold mb-3" style="color:#2c3e7a; font-size:13px;">
                                            <span class="fa fa-file-excel-o me-1"/>Generated Workbook
                                        </div>
                                        <div t-if="state.card.ai_vendor_attachment_id"
                                             class="d-flex align-items-center gap-3 p-3 rounded"
                                             style="background:white; border:1px solid #d0d9f5;">
                                            <span class="fa fa-file-excel-o text-success" style="font-size:2rem;"/>
                                            <div>
                                                <div class="fw-semibold">Vendor Intelligence Data</div>
                                                <div class="text-muted small">Vendor scoring and purchase data prepared for AI analysis.</div>
                                            </div>
                                            <a t-att-href="'/web/content/' + state.card.ai_vendor_attachment_id + '?download=true'"
                                               class="btn btn-outline-success btn-sm ms-auto">
                                                <span class="fa fa-download me-1"/>Download
                                            </a>
                                        </div>
                                        <div t-if="!state.card.ai_vendor_attachment_id"
                                             class="d-flex align-items-center gap-2 p-3 rounded text-muted"
                                             style="background:white; border:1px dashed #d0d9f5; font-size:13px;">
                                            <span class="fa fa-info-circle"/>
                                            No workbook generated yet. Save settings in Step 3 first.
                                        </div>
                                    </div>
                                </div>
                                <div class="col-md-5">
                                    <div class="p-3 rounded h-100"
                                         style="background:#f0f4ff; border:1px solid #d0d9f5;">
                                        <div class="fw-semibold mb-2" style="color:#2c3e7a; font-size:13px;">
                                            <span class="fa fa-robot me-1"/>AI Analysis
                                        </div>
                                        <div class="text-muted mb-3" style="font-size:12px;">
                                            Run the vendor analyst on the latest workbook and review recommendations in Step 5.
                                        </div>
                                        <ul class="list-unstyled mb-0" style="font-size:12px; color:#2c3e7a;">
                                            <li class="mb-2"><span class="fa fa-search text-primary me-2"/>Analyzes
                                                pricing, lead times, and fulfillment</li>
                                            <li class="mb-2"><span class="fa fa-exclamation-triangle text-warning me-2"/>
                                                Identifies critical supply chain red flags</li>
                                            <li class="mb-0"><span class="fa fa-trophy text-success me-2"/>Ranks vendors
                                                by overall performance</li>
                                        </ul>
                                    </div>
                                </div>
                            </div>

                            <div class="d-flex justify-content-between mt-4">
                                <button class="btn btn-outline-secondary" t-on-click="onPrevStep"><i class="fa fa-arrow-left me-1"/>
                                    Previous</button>
                                <button class="btn btn-primary btn-sm"
                                        t-on-click="onClickRunAI"
                                        t-att-disabled="state.isBusy || !state.card.ai_vendor_attachment_id">
                                    <span class="fa fa-magic me-1"/>Run AI Analysis
                                </button>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- STEP 5: RESULTS -->
                <div class="card mb-3 shadow-sm">
                    <div class="card-header d-flex justify-content-between align-items-center"
                         t-on-click="() => this.state.currentWizardStep = (this.state.currentWizardStep === 5 ? 0 : 5)"
                         style="cursor:pointer;">
                        <strong><span class="fa fa-bar-chart me-2"/>
                            Step 5: Result Overview</strong>
                        <i t-att-class="state.currentWizardStep === 5 ? 'fa fa-chevron-down toggle-icon' : 'fa fa-chevron-up toggle-icon'"/>
                    </div>
                    <div t-att-class="state.currentWizardStep === 5 ? 'collapse show' : 'collapse'">
                        <div class="card-body p-4" style="background-color: #f8f9fa;">
                            
                            <div t-if="!state.card.ai_vendor_analysis_result" class="text-muted text-center py-5">
                                <i class="fa fa-folder-open-o fa-3x mb-3 opacity-50"/>
                                <h5>No Analysis Results Yet</h5>
                                <p>Run the AI Analysis in Step 4 to see insights here.</p>
                            </div>

                            <!-- Fallback for non-JSON results -->
                            <div t-if="state.card.ai_vendor_analysis_result &amp;&amp; !state.parsedAIResult"
                                 class="bg-white p-4 rounded border" style="white-space: pre-wrap;">
                                <t t-esc="state.card.ai_vendor_analysis_result"/>
                            </div>

                            <!-- Dashboard Layout -->
                            <div t-if="state.parsedAIResult">

                                <!-- Executive Summary -->
                                <div class="p-4 mb-4 rounded shadow-sm"
                                     style="background: linear-gradient(135deg, #4472C4, #2c3e7a); color: white;">
                                    <h5 class="fw-bold mb-2"><i class="fa fa-lightbulb-o me-2 text-warning"></i>
                                        Executive Summary</h5>
                                    <p class="mb-0" style="font-size: 15px; opacity: 0.95;"><t t-esc="state.parsedAIResult.executive_summary"/></p>
                                </div>

                                <div class="row g-3 mb-4">
                                    <!-- Usually Delays -->
                                    <div class="col-md-4">
                                        <div class="card h-100 border-0 shadow-sm"
                                             style="border-left: 4px solid #dc3545 !important;">
                                            <div class="card-body p-3">
                                                <div class="d-flex align-items-center mb-3 text-danger">
                                                    <i class="fa fa-clock-o fa-2x me-2"/>
                                                    <h6 class="mb-0 fw-bold">Usually Delays</h6>
                                                </div>
                                                <t t-foreach="state.parsedAIResult.worst_delays" t-as="item"
                                                   t-key="item_index">
                                                    <div class="d-flex align-items-start gap-2 mb-2 pb-2"
                                                         t-att-style="item_index lt state.parsedAIResult.worst_delays.length - 1 ? 'border-bottom: 1px solid #f1f1f1;' : ''">
                                                        <span class="badge rounded-pill text-bg-danger mt-1"
                                                              style="font-size:10px; min-width:20px;">
                                                            <t t-esc="item.rank || (item_index + 1)"/>
                                                        </span>
                                                        <div>
                                                            <div class="fw-semibold text-dark" style="font-size:12px;"><t t-esc="item.vendor || item.name || '-'"/> - <t
                                                                    t-esc="item.reason || '-'"/>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </t>
                                                <div t-if="!state.parsedAIResult.worst_delays.length"
                                                     class="text-muted small">No data</div>
                                            </div>
                                        </div>
                                    </div>
                                    <!-- Fastest Delivery -->
                                    <div class="col-md-4">
                                        <div class="card h-100 border-0 shadow-sm"
                                             style="border-left: 4px solid #28a745 !important;">
                                            <div class="card-body p-3">
                                                <div class="d-flex align-items-center mb-3 text-success">
                                                    <i class="fa fa-rocket fa-2x me-2"/>
                                                    <h6 class="mb-0 fw-bold">Fastest Delivery</h6>
                                                </div>
                                                <t t-foreach="state.parsedAIResult.fastest_delivery" t-as="item"
                                                   t-key="item_index">
                                                    <div class="d-flex align-items-start gap-2 mb-2 pb-2"
                                                         t-att-style="item_index lt state.parsedAIResult.fastest_delivery.length - 1 ? 'border-bottom: 1px solid #f1f1f1;' : ''">
                                                        <span class="badge rounded-pill text-bg-success mt-1"
                                                              style="font-size:10px; min-width:20px;">
                                                            <t t-esc="item.rank || (item_index + 1)"/>
                                                        </span>
                                                        <div>
                                                            <div class="fw-semibold text-dark" style="font-size:12px;"><t t-esc="item.vendor || item.name || '-'"/> —
                                                                <t t-esc="item.speed || item.reason || '-'"/>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </t>
                                                <div t-if="!state.parsedAIResult.fastest_delivery.length"
                                                     class="text-muted small">No data</div>
                                            </div>
                                        </div>
                                    </div>
                                    <!-- Best Rates -->
                                    <div class="col-md-4">
                                        <div class="card h-100 border-0 shadow-sm"
                                             style="border-left: 4px solid #ffc107 !important;">
                                            <div class="card-body p-3">
                                                <div class="d-flex align-items-center mb-3 text-warning">
                                                    <i class="fa fa-money fa-2x me-2"/>
                                                    <h6 class="mb-0 fw-bold text-dark">Best Rates</h6>
                                                </div>
                                                <t t-foreach="state.parsedAIResult.best_rates" t-as="item"
                                                   t-key="item_index">
                                                    <div class="d-flex align-items-start gap-2 mb-2 pb-2"
                                                         t-att-style="item_index lt state.parsedAIResult.best_rates.length - 1 ? 'border-bottom: 1px solid #f1f1f1;' : ''">
                                                        <span class="badge rounded-pill text-bg-warning mt-1"
                                                              style="font-size:10px; min-width:20px;">
                                                            <t t-esc="item.rank || (item_index + 1)"/>
                                                        </span>
                                                        <div>
                                                            <div class="fw-semibold text-dark" style="font-size:12px;"><t t-esc="item.vendor || item.name || '-'"/> —
                                                            <t t-esc="item.reason || '-'"/></div>
                                                        </div>
                                                    </div>
                                                </t>
                                                <div t-if="!state.parsedAIResult.best_rates.length"
                                                     class="text-muted small">No data</div>
                                            </div>
                                        </div>
                                    </div>
                                </div>


                                <div class="row g-4 mb-4">
                                    <!-- CSS Chart -->
                                    <div class="col-md-7">
                                        <div class="card shadow-sm border-0 h-100">
                                            <div class="card-body p-4">
                                                <div class="d-flex justify-content-between align-items-center mb-4">
                                                    <h6 class="fw-bold text-primary mb-0"><i class="fa fa-pie-chart me-2"></i>
                                                        Top Vendors Overall Comparison</h6>
                                                    <select class="form-select form-select-sm w-auto"
                                                            t-on-change="onChangeVendorLimit">
                                                        <option value="5" t-att-selected="state.vendorLimit == 5">Top 5 Vendors</option>
                                                        <option value="10" t-att-selected="state.vendorLimit == 10">Top 10 Vendors</option>
                                                    </select>
                                                </div>
                                                <div style="height: 300px; width: 100%;">
                                                    <canvas t-ref="vendorChartCanvas"></canvas>
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- Action Plan & Red Flags -->
                                    <div class="col-md-5">
                                        <div class="card shadow-sm border-0 h-100">
                                            <div class="card-body p-4 d-flex flex-column gap-4">
                                                
                                                <!-- Category Kings -->
                                                <div t-if="state.parsedAIResult.category_kings.length > 0">
                                                    <h6 class="fw-bold text-info mb-3"><i class="fa fa-trophy me-2"></i>
                                                        Category Kings</h6>
                                                    <ul class="list-unstyled mb-0">
                                                        <t t-foreach="state.parsedAIResult.category_kings" t-as="king"
                                                           t-key="king_index">
                                                            <li class="d-flex align-items-center justify-content-between mb-2 pb-2 border-bottom text-dark small">
                                                                <div>
                                                                    <span class="badge text-bg-warning me-2"><t t-esc="king.category"/></span>
                                                                    <span class="fw-semibold"><t t-esc="king.vendor"/></span>
                                                                </div>
                                                                <span class="badge text-bg-success"><t t-esc="king.score"/> / 100</span>
                                                            </li>
                                                        </t>
                                                    </ul>
                                                </div>

                                                <!-- Red Flags -->
<!--                                                <div t-if="state.parsedAIResult.red_flags.length > 0">-->
<!--                                                    <h6 class="fw-bold text-danger mb-3"><i class="fa fa-exclamation-triangle me-2"></i>-->
<!--                                                        Red Flags</h6>-->
<!--                                                    <ul class="list-unstyled mb-0">-->
<!--                                                        <t t-foreach="state.parsedAIResult.red_flags" t-as="flag"-->
<!--                                                           t-key="flag_index">-->
<!--                                                            <li class="d-flex gap-2 mb-2 text-danger small">-->
<!--                                                                <i class="fa fa-times-circle mt-1"></i>-->
<!--                                                                <span><t t-esc="flag"/></span>-->
<!--                                                            </li>-->
<!--                                                        </t>-->
<!--                                                    </ul>-->
<!--                                                </div>-->

                                                <!-- Action Plan -->
                                                <div>
                                                    <h6 class="fw-bold text-success mb-3"><i class="fa fa-check-square-o me-2"></i>
                                                        Action Plan</h6>
                                                    <ul class="list-unstyled mb-0">
                                                        <t t-foreach="state.parsedAIResult.action_plan" t-as="action"
                                                           t-key="action_index">
                                                            <li class="d-flex gap-2 mb-2 text-dark small">
                                                                <i class="fa fa-arrow-right text-success mt-1"></i>
                                                                <span><t t-esc="action"/></span>
                                                            </li>
                                                        </t>
                                                    </ul>
                                                </div>

                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="d-flex justify-content-between mt-4">
                                <button class="btn btn-outline-secondary" t-on-click="onPrevStep"><i class="fa fa-arrow-left me-1"/>
                                    Previous</button>
                                <button class="btn btn-primary" t-on-click="onClickReRunAI" t-att-disabled="!state.card.ai_vendor_analysis_result">
                                    <i class="fa fa-refresh me-1"/>
                                    Re-Run AI Analysis
                                </button>
                            </div>
                        </div>
                    </div>
                </div>

            </div>
        </xpath>
    </t>
</templates>
