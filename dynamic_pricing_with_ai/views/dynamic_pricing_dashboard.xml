<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <!-- Client Action — registers tag in Odoo actions registry -->
    <record id="action_dynamic_pricing_dashboard" model="ir.actions.client">
        <field name="name">Dynamic Pricing AI Dashboard</field>
        <field name="tag">dynamic_pricing_dashboard</field>
    </record>

    <!-- OWL Template — referenced by static template name in JS -->
    <template id="dynamic_pricing_with_ai.Dashboard" name="Dynamic Pricing Dashboard">
        <div class="dp-wrapper">

            <h1 class="dp-title">🤖 Dynamic Pricing AI Engine</h1>
            <p class="dp-subtitle">AI automatically adjusts · Selling Price · Discount · Margin · in real-time</p>

            <!-- Loading -->
            <div t-if="state.status === 'loading'" class="dp-loading-state">
                <div class="dp-spinner"/>
                <p>Loading products from Odoo...</p>
            </div>

            <!-- Error -->
            <div t-if="state.status === 'error'" class="dp-error-state">
                <p>⚠️ <t t-esc="state.errorMsg"/></p>
            </div>

            <!-- Ready -->
            <t t-if="state.status === 'ready'">

                <!-- Product Tabs -->
                <div class="dp-product-tabs">
                    <t t-foreach="state.products" t-as="product" t-key="product.id">
                        <div class="dp-ptab"
                             t-att-class="{ active: product_index === state.currentIdx }"
                             t-on-click="() => this.selectProduct(product_index)">
                            <t t-esc="product.name"/>
                        </div>
                    </t>
                </div>

                <!-- Dashboard Grid -->
                <div class="dp-grid">

                    <!-- AI Input Signals -->
                    <div class="dp-card">
                        <div class="dp-card-title">📡 AI Input Signals</div>
                        <div class="dp-signals">
                            <t t-foreach="currentProduct.signals" t-as="sig" t-key="sig.label">
                                <div class="dp-signal-item">
                                    <div class="dp-signal-label"><t t-esc="sig.label"/></div>
                                    <div class="dp-signal-val" t-att-style="'color:' + sig.color">
                                        <t t-esc="sig.val"/>%
                                    </div>
                                    <div class="dp-bar-bg">
                                        <div class="dp-bar-fill"
                                             t-att-style="'width:' + sig.val + '%;background:' + sig.color"/>
                                    </div>
                                </div>
                            </t>
                        </div>
                    </div>

                    <!-- Price Adjustment Output -->
                    <div class="dp-card">
                        <div class="dp-card-title">💰 Price Adjustment Output</div>
                        <div class="dp-price-row">
                            <div class="dp-price-box highlight">
                                <div class="dp-price-label">AI Selling Price</div>
                                <div class="dp-price-val" style="color:#a5b4fc">
                                    <t t-esc="dp_fmt(priceData.aiPrice)"/>
                                </div>
                                <div t-att-class="'dp-price-change ' + priceData.pDir">
                                    <t t-esc="priceData.pArrow"/>&#160;<t t-esc="Math.abs(currentDecision.pct)"/>% vs base
                                </div>
                            </div>
                            <div class="dp-price-box">
                                <div class="dp-price-label">AI Discount</div>
                                <div class="dp-price-val" style="color:#f87171">
                                    <t t-esc="priceData.aiDiscount"/>%
                                </div>
                                <div t-att-class="'dp-price-change ' + (priceData.aiDiscount &lt; priceData.baseDiscount ? 'dp-up' : 'dp-down')">
                                    <t t-esc="priceData.aiDiscount &lt; priceData.baseDiscount ? '▼' : '▲'"/>
                                    was <t t-esc="priceData.baseDiscount"/>%
                                </div>
                            </div>
                            <div class="dp-price-box">
                                <div class="dp-price-label">AI Margin</div>
                                <div class="dp-price-val" style="color:#4ade80">
                                    <t t-esc="priceData.aiMargin"/>%
                                </div>
                                <div t-att-class="'dp-price-change ' + (priceData.aiMargin &gt; priceData.baseMargin ? 'dp-up' : 'dp-down')">
                                    <t t-esc="priceData.aiMargin &gt; priceData.baseMargin ? '▲' : '▼'"/>
                                    was <t t-esc="priceData.baseMargin"/>%
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- AI Decision and Reasoning -->
                    <div class="dp-card dp-full">
                        <div class="dp-card-title">🧠 AI Decision &amp; Reasoning</div>
                        <div t-att-class="'dp-decision-box ' + currentDecision.type">
                            <div class="dp-decision-icon"><t t-esc="currentDecision.icon"/></div>
                            <div class="dp-decision-text">
                                <div class="dp-decision-title" t-att-style="'color:' + decisionColor">
                                    <t t-esc="currentDecision.title"/>
                                </div>
                                <div class="dp-decision-reason">
                                    <t t-esc="currentDecision.reason"/>
                                </div>
                            </div>
                            <span class="dp-confidence" t-att-style="'color:' + decisionColor">
                                <t t-esc="currentDecision.confidence"/>
                            </span>
                        </div>
                        <div class="dp-factors">
                            <span class="dp-factors-label">Factors used:</span>
                            <t t-foreach="currentDecision.tags" t-as="tag" t-key="tag">
                                <span t-att-class="'dp-tag ' + tag">
                                    <t t-esc="DP_TAG_MAP[tag]"/>
                                </span>
                            </t>
                        </div>
                    </div>

                    <!-- What-If Scenario Simulator -->
                    <div class="dp-card">
                        <div class="dp-card-title">🏛️ What-If Scenario Simulator</div>
                        <div class="dp-slider-row">
                            <label>Demand Level</label>
                            <input type="range" min="0" max="100"
                                   t-att-value="state.simDemand"
                                   t-on-input="(e) => this.onSlider(e, 'simDemand')"/>
                            <span class="dp-slider-val"><t t-esc="state.simDemand"/></span>
                        </div>
                        <div class="dp-slider-row">
                            <label>Inventory %</label>
                            <input type="range" min="0" max="100"
                                   t-att-value="state.simInventory"
                                   t-on-input="(e) => this.onSlider(e, 'simInventory')"/>
                            <span class="dp-slider-val"><t t-esc="state.simInventory"/></span>
                        </div>
                        <div class="dp-slider-row">
                            <label>Comp. Price</label>
                            <input type="range" min="0" max="100"
                                   t-att-value="state.simComp"
                                   t-on-input="(e) => this.onSlider(e, 'simComp')"/>
                            <span class="dp-slider-val"><t t-esc="state.simComp"/></span>
                        </div>
                        <div class="dp-divider"/>
                        <div t-innerHTML="simResultHtml"/>
                        <button class="dp-sim-btn" t-on-click="applySimulation">
                            ⚡ Apply &amp; Log This Simulation
                        </button>
                    </div>

                    <!-- AI Price Change Log -->
                    <div class="dp-card">
                        <div class="dp-card-title">📋 AI Price Change Log</div>
                        <table class="dp-hist-table">
                            <thead>
                                <tr>
                                    <th>Time</th>
                                    <th>Product</th>
                                    <th>Action</th>
                                    <th>Reason</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-if="state.history.length === 0">
                                    <tr>
                                        <td colspan="4" style="color:#4a5168;text-align:center;padding:12px;">
                                            No changes logged yet. Apply a simulation to start.
                                        </td>
                                    </tr>
                                </t>
                                <t t-foreach="state.history" t-as="h" t-key="h_index">
                                    <tr>
                                        <td style="color:#4a5168"><t t-esc="h.time"/></td>
                                        <td><t t-esc="h.product"/></td>
                                        <td>
                                            <span t-att-class="'dp-badge ' + h.action">
                                                <t t-esc="h.label"/>
                                            </span>
                                        </td>
                                        <td style="color:#94a3b8"><t t-esc="h.reason"/></td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>
                    </div>

                </div>
            </t>

        </div>
    </template>

</odoo>