<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="dynamic_pricing_ai_log_form_view" model="ir.ui.view">
        <field name="name">vraja.ai.log.form.dynamic.pricing</field>
        <field name="model">vraja.ai.log</field>
        <field name="inherit_id" ref="vraja_ai.vraja_ai_log_form"/>
        <field name="arch" type="xml">

            <xpath expr="//form" position="inside">
                <sheet invisible="vraja_common_log_store != 'dynamic_pricing'">

                    <!-- STATUS ALERTS -->
                    <div class="alert alert-success mb-4" invisible="status != 'success'">
                        <span class="fa fa-check-circle me-2"/>
                        Dynamic pricing analysis completed successfully.
                    </div>
                    <div class="alert alert-warning mb-4" invisible="status != 'partial'">
                        <span class="fa fa-exclamation-triangle me-2"/>
                        Some products were skipped during processing.
                    </div>
                    <div class="alert alert-danger mb-4" invisible="status != 'failed'">
                        <span class="fa fa-times-circle me-2"/>
                        AI request failed while processing pricing recommendations.
                    </div>

                    <!-- TITLE -->
                    <div class="oe_title mb-3">
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>

                    <!-- RUN INFO -->
                    <group>
                        <group string="Run Information">
                            <field name="run_date"/>
                            <field name="vraja_common_log_store"/>
                            <field name="status" widget="badge"/>
                            <field name="dp_applied" widget="boolean_toggle"/>
                            <field name="dp_pricelists_updated"/>
                        </group>
                        <group string="AI Statistics">
                            <field name="dp_total_products"/>
                            <field name="dp_total_tokens"/>
                        </group>
                        <group string="Execution Log" colspan="2">
                            <field name="dp_log_message" nolabel="1"/>
                        </group>
                    </group>

                    <!-- SUMMARY CARDS -->
                    <div class="row mt-4 mb-4" invisible="dp_total_products == 0">
                        <div class="col-lg-3">
                            <div class="p-3 rounded text-center"
                                 style="background:#f0f4ff; border:1px solid #d0d9f5; min-height:100px;">
                                <div style="font-size:30px; font-weight:700; color:#4472C4;">
                                    <field name="dp_total_products" readonly="1"/>
                                </div>
                                <div class="text-muted small">Products Analysed</div>
                            </div>
                        </div>
                        <div class="col-lg-3">
                            <div class="p-3 rounded text-center"
                                 style="background:#f0fff4; border:1px solid #a3cfbb; min-height:100px;">
                                <div style="font-size:30px; font-weight:700; color:#27ae60;">
                                    <field name="dp_increase_count" readonly="1"/>
                                </div>
                                <div class="text-muted small">Price Increased</div>
                            </div>
                        </div>
                        <div class="col-lg-3">
                            <div class="p-3 rounded text-center"
                                 style="background:#fff5f5; border:1px solid #f5c6cb; min-height:100px;">
                                <div style="font-size:30px; font-weight:700; color:#e74c3c;">
                                    <field name="dp_decrease_count" readonly="1"/>
                                </div>
                                <div class="text-muted small">Price Decreased</div>
                            </div>
                        </div>
                        <div class="col-lg-3">
                            <div class="p-3 rounded text-center"
                                 style="background:#fafafa; border:1px solid #dee2e6; min-height:100px;">
                                <div style="font-size:30px; font-weight:700; color:#6c757d;">
                                    <field name="dp_hold_count" readonly="1"/>
                                </div>
                                <div class="text-muted small">Held / Skipped</div>
                            </div>
                        </div>
                    </div>

                    <!-- SINGLE UNIFIED TABLE -->
                    <notebook invisible="dp_total_products == 0">
                        <page string="Pricing Analysis">
                            <field name="line_ids" nolabel="1" readonly="1">
                                <list decoration-muted="dp_status == 'skipped'" decoration-danger="dp_status == 'failed'">
                                    <field name="dp_product_name" string="Product" width="200"/>
                                    <field name="dp_segment_name" string="Segment" width="100"/>
                                    <field name="dp_old_price" string="Current Price" width="110"/>
                                    <field name="dp_ai_suggested_price" string="Suggested Price" width="110"/>
                                    <field name="dp_decision" string="Decision" widget="badge" width="90" decoration-success="dp_decision == 'increase'"
                                           decoration-danger="dp_decision == 'decrease'"
                                           decoration-info="dp_decision == 'hold'"
                                           decoration-warning="dp_decision == 'skip'"/>
                                    <field name="dp_margin_before" string="Margin Before (%)" width="120"/>
                                    <field name="dp_margin_after" string="Margin After (%)" width="120"/>
                                    <field name="dp_status"  string="Status" widget="badge" width="80"
                                           decoration-success="dp_status == 'success'"
                                           decoration-warning="dp_status == 'skipped'"
                                           decoration-danger="dp_status == 'failed'"/>
                                    <field name="dp_reason" string="AI Reason" width="250" optional="show"/>
                                </list>
                            </field>
                        </page>
                    </notebook>

                </sheet>
            </xpath>
        </field>
    </record>

    <!-- SEARCH VIEW -->
    <record id="dynamic_pricing_ai_log_search_view" model="ir.ui.view">
        <field name="name">vraja.ai.log.search.dynamic.pricing</field>
        <field name="model">vraja.ai.log</field>
        <field name="inherit_id" ref="vraja_ai.vraja_common_ai_log_search"/>
        <field name="arch" type="xml">
            <xpath expr="//search" position="inside">
                <separator/>
                <filter string="Dynamic Pricing AI"
                        name="filter_dynamic_pricing_ai"
                        domain="[('vraja_common_log_store','=','dynamic_pricing')]"/>
            </xpath>
        </field>
    </record>

</odoo>