<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

<t t-name="dynamic_pricing_analysis_dashboard_template">
<div class="dpad-shell">

    <!-- ═══════════════════════════════════════════════════════
         HEADER — Brand + Filters
    ════════════════════════════════════════════════════════ -->
    <header class="dpad-header">
        <div class="dpad-header__brand">
            <div class="dpad-header__icon">
                <i class="fa fa-line-chart"/>
            </div>
            <div>
                <div class="dpad-header__kicker">Dynamic Pricing AI</div>
                <h1 class="dpad-header__title">Pricing Intelligence</h1>
                <p class="dpad-header__sub">
                    <t t-if="card.analyzed_on">
                        Last AI run: <strong><t t-esc="card.analyzed_on"/></strong>
                    </t>
                    <t t-else="">No AI run yet — run analysis from the dashboard</t>
                </p>
            </div>
        </div>

        <div class="dpad-header__controls">
            <div class="dpad-control-group">
                <label>Period</label>
                <div class="dpad-pill-group">
                    <button type="button" t-att-class="periodButtonClass('last_7_days')"
                            t-on-click="() => this.setPeriod('last_7_days')">7 Days</button>
                    <button type="button" t-att-class="periodButtonClass('last_30_days')"
                            t-on-click="() => this.setPeriod('last_30_days')">30 Days</button>
                    <button type="button" t-att-class="periodButtonClass('custom')"
                            t-on-click="() => this.setPeriod('custom')">Custom</button>
                </div>
            </div>
            <div class="dpad-control-group">
                <label>Top Products</label>
                <div class="dpad-pill-group">
                    <button type="button" t-att-class="limitButtonClass(5)"
                            t-on-click="() => this.setLimit(5)">5</button>
                    <button type="button" t-att-class="limitButtonClass(10)"
                            t-on-click="() => this.setLimit(10)">10</button>
                    <button type="button" t-att-class="limitButtonClass(15)"
                            t-on-click="() => this.setLimit(15)">15</button>
                </div>
            </div>
            <div t-if="state.period === 'custom'" class="dpad-date-row">
                <div class="dpad-date-field">
                    <label>From</label>
                    <input type="date" t-att-value="state.dateFrom"
                           t-on-change="(ev) => this.onCustomDateChange('dateFrom', ev)"/>
                </div>
                <div class="dpad-date-field">
                    <label>To</label>
                    <input type="date" t-att-value="state.dateTo"
                           t-on-change="(ev) => this.onCustomDateChange('dateTo', ev)"/>
                </div>
            </div>
        </div>
    </header>

    <!-- ═══════════════════════════════════════════════════════
         LOADING / ERROR
    ════════════════════════════════════════════════════════ -->
    <div t-if="state.loading" class="dpad-state">
        <div class="dpad-state__spinner">
            <span class="fa fa-spinner fa-spin"/>
        </div>
        <p>Building pricing intelligence...</p>
    </div>

    <div t-if="state.error and !state.loading" class="dpad-state dpad-state--error">
        <span class="fa fa-exclamation-circle"/>
        <p><t t-esc="state.error"/></p>
    </div>

    <t t-if="!state.loading and !state.error">

        <!-- ═════════════════════════════════════════════════
             DATE CONTEXT STRIP
        ══════════════════════════════════════════════════ -->
        <div class="dpad-strip">
            <span class="dpad-strip__item">
                <i class="fa fa-calendar me-1"/>
                <t t-esc="filters.date_from"/> — <t t-esc="filters.date_to"/>
            </span>
            <span class="dpad-strip__item">
                <i class="fa fa-cube me-1"/>
                <strong><t t-esc="summary.total_products || 0"/></strong> Products
            </span>
            <span class="dpad-strip__item">
                <i class="fa fa-users me-1"/>
                <strong><t t-esc="summary.total_segments || 0"/></strong> Segments
            </span>
            <span class="dpad-strip__item">
                <i class="fa fa-tags me-1"/>
                <strong><t t-esc="summary.analyzed_products || 0"/></strong> AI Results
            </span>
        </div>

        <!-- ═════════════════════════════════════════════════
             ROW 1 — KPI CARDS
        ══════════════════════════════════════════════════ -->
        <div class="dpad-kpi-row">

            <div class="dpad-kpi dpad-kpi--cyan">
                <div class="dpad-kpi__icon"><i class="fa fa-shopping-cart"/></div>
                <div class="dpad-kpi__body">
                    <div class="dpad-kpi__value"><t t-esc="formatMoney(summary.total_revenue)"/></div>
                    <div class="dpad-kpi__label">Total Revenue</div>
                    <div class="dpad-kpi__sub"><t t-esc="formatNumber(summary.total_qty_sold)"/> units sold</div>
                </div>
            </div>

            <div class="dpad-kpi dpad-kpi--green">
                <div class="dpad-kpi__icon"><i class="fa fa-arrow-up"/></div>
                <div class="dpad-kpi__body">
                    <div class="dpad-kpi__value"><t t-esc="summary.increase_count || 0"/></div>
                    <div class="dpad-kpi__label">Price Increases</div>
                    <div class="dpad-kpi__sub">AI recommended increase</div>
                </div>
            </div>

            <div class="dpad-kpi dpad-kpi--pink">
                <div class="dpad-kpi__icon"><i class="fa fa-arrow-down"/></div>
                <div class="dpad-kpi__body">
                    <div class="dpad-kpi__value"><t t-esc="summary.decrease_count || 0"/></div>
                    <div class="dpad-kpi__label">Price Decreases</div>
                    <div class="dpad-kpi__sub">AI recommended decrease</div>
                </div>
            </div>

            <div class="dpad-kpi dpad-kpi--orange">
                <div class="dpad-kpi__icon"><i class="fa fa-percent"/></div>
                <div class="dpad-kpi__body">
                    <div class="dpad-kpi__value"><t t-esc="formatNumber(summary.avg_margin_lift)"/>%</div>
                    <div class="dpad-kpi__label">Avg Margin Lift</div>
                    <div class="dpad-kpi__sub">AI margin after vs before</div>
                </div>
            </div>

            <div class="dpad-kpi dpad-kpi--blue">
                <div class="dpad-kpi__icon"><i class="fa fa-exchange"/></div>
                <div class="dpad-kpi__body">
                    <div class="dpad-kpi__value"><t t-esc="formatNumber(summary.avg_price_change)"/>%</div>
                    <div class="dpad-kpi__label">Avg Price Move</div>
                    <div class="dpad-kpi__sub">across actionable decisions</div>
                </div>
            </div>

        </div>

        <!-- ═════════════════════════════════════════════════
             ROW 2 — HERO PRODUCT + DECISION MIX
        ══════════════════════════════════════════════════ -->
        <div class="dpad-row2">

            <!-- Hero Product -->
            <div class="dpad-panel dpad-hero">
                <div class="dpad-panel__head">
                    <span class="dpad-kicker">Top Opportunity</span>
                    <h2>Best product to review</h2>
                </div>
                <t t-if="heroProduct">
                    <div class="dpad-hero__top">
                        <div class="dpad-hero__rank">#1</div>
                        <span t-att-class="decisionClass(heroProduct.decision)">
                            <i t-att-class="'fa ' + decisionIcon(heroProduct.decision) + ' me-1'"/>
                            <t t-esc="decisionLabel(heroProduct.decision)"/>
                        </span>
                    </div>
                    <h3 class="dpad-hero__name"><t t-esc="heroProduct.product_name"/></h3>
                    <div class="dpad-hero__segment" t-if="heroProduct.segment_name">
                        <i class="fa fa-users me-1"/><t t-esc="heroProduct.segment_name"/>
                    </div>
                    <p class="dpad-hero__reason"><t t-esc="heroProduct.reason"/></p>
                    <div class="dpad-hero__prices">
                        <div class="dpad-price-box">
                            <span>Current Price</span>
                            <strong><t t-esc="formatMoney(heroProduct.current_price)"/></strong>
                        </div>
                        <div class="dpad-price-arrow"><i class="fa fa-long-arrow-right"/></div>
                        <div class="dpad-price-box dpad-price-box--ai">
                            <span>AI Suggested</span>
                            <strong><t t-esc="formatMoney(heroProduct.suggested_price)"/></strong>
                        </div>
                    </div>
                    <div class="dpad-hero__metrics">
                        <div class="dpad-metric">
                            <span>Revenue</span>
                            <strong><t t-esc="formatMoney(heroProduct.revenue)"/></strong>
                        </div>
                        <div class="dpad-metric">
                            <span>Units Sold</span>
                            <strong><t t-esc="formatNumber(heroProduct.qty_sold)"/></strong>
                        </div>
                        <div class="dpad-metric">
                            <span>Price Delta</span>
                            <strong t-att-class="heroProduct.price_delta >= 0 ? 'dpad-positive' : 'dpad-negative'">
                                <t t-esc="formatPct(heroProduct.price_delta_pct)"/>
                            </strong>
                        </div>
                        <div class="dpad-metric">
                            <span>Margin</span>
                            <strong>
                                <t t-esc="formatNumber(heroProduct.margin_before)"/>%
                                <i class="fa fa-arrow-right mx-1" style="font-size:10px;"/>
                                <t t-esc="formatNumber(heroProduct.margin_after)"/>%
                            </strong>
                        </div>
                    </div>
                </t>
                <div t-else="" class="dpad-empty">
                    <i class="fa fa-info-circle me-2"/>
                    No products found. Select products and run AI analysis first.
                </div>
            </div>

            <!-- Decision Mix -->
            <div class="dpad-panel dpad-decision-mix">
                <div class="dpad-panel__head">
                    <span class="dpad-kicker">AI Decision Split</span>
                    <h2>Decision breakdown</h2>
                </div>
                <div class="dpad-mix-list">
                    <t t-foreach="decisionMix" t-as="item" t-key="item.key">
                        <div class="dpad-mix-item" t-if="item.count > 0">
                            <div class="dpad-mix-item__top">
                                <div class="dpad-mix-item__dot" t-att-style="'background:' + item.color"/>
                                <span class="dpad-mix-item__label"><t t-esc="item.label"/></span>
                                <span class="dpad-mix-item__count"><t t-esc="item.count"/></span>
                                <span class="dpad-mix-item__pct"><t t-esc="item.percent"/>%</span>
                            </div>
                            <div class="dpad-mix-bar">
                                <div class="dpad-mix-bar__fill"
                                     t-att-style="'width:' + item.percent + '%; background:' + item.color"/>
                            </div>
                        </div>
                    </t>
                </div>

                <!-- Action map -->
                <div class="dpad-action-grid">
                    <div class="dpad-action-tile dpad-action-tile--green">
                        <i class="fa fa-arrow-up"/>
                        <strong><t t-esc="summary.increase_count || 0"/></strong>
                        <span>Increase</span>
                    </div>
                    <div class="dpad-action-tile dpad-action-tile--red">
                        <i class="fa fa-arrow-down"/>
                        <strong><t t-esc="summary.decrease_count || 0"/></strong>
                        <span>Decrease</span>
                    </div>
                    <div class="dpad-action-tile dpad-action-tile--yellow">
                        <i class="fa fa-minus"/>
                        <strong><t t-esc="summary.hold_count || 0"/></strong>
                        <span>Hold</span>
                    </div>
                    <div class="dpad-action-tile dpad-action-tile--grey">
                        <i class="fa fa-ban"/>
                        <strong><t t-esc="summary.skip_count || 0"/></strong>
                        <span>Skip</span>
                    </div>
                </div>
            </div>

        </div>

        <!-- ═════════════════════════════════════════════════
             ROW 3 — SEGMENT PERFORMANCE
        ══════════════════════════════════════════════════ -->
        <div class="dpad-panel dpad-segment-panel" t-if="hasSegments">
            <div class="dpad-panel__head">
                <span class="dpad-kicker">Segment Intelligence</span>
                <h2>Performance by customer segment</h2>
            </div>
            <div class="dpad-segment-table-wrap">
                <table class="dpad-segment-table">
                    <thead>
                        <tr>
                            <th>Segment</th>
                            <th>Products</th>
                            <th>Revenue</th>
                            <th>Margin Before</th>
                            <th>Margin After</th>
                            <th>Improvement</th>
                            <th>Increase</th>
                            <th>Decrease</th>
                            <th>Hold</th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-foreach="segmentData" t-as="seg" t-key="seg.segment_name">
                            <tr>
                                <td>
                                    <div class="dpad-seg-name">
                                        <div class="dpad-seg-dot"/>
                                        <t t-esc="seg.segment_name"/>
                                    </div>
                                </td>
                                <td class="dpad-td-center"><t t-esc="seg.products"/></td>
                                <td><t t-esc="formatMoney(seg.revenue)"/></td>
                                <td>
                                    <div class="dpad-margin-cell">
                                        <div class="dpad-margin-bar">
                                            <div class="dpad-margin-bar__fill dpad-margin-bar__fill--before"
                                                 t-att-style="'width:' + marginBarWidth(seg.avg_margin_before)"/>
                                        </div>
                                        <span><t t-esc="formatNumber(seg.avg_margin_before)"/>%</span>
                                    </div>
                                </td>
                                <td>
                                    <div class="dpad-margin-cell">
                                        <div class="dpad-margin-bar">
                                            <div class="dpad-margin-bar__fill dpad-margin-bar__fill--after"
                                                 t-att-style="'width:' + marginBarWidth(seg.avg_margin_after)"/>
                                        </div>
                                        <span><t t-esc="formatNumber(seg.avg_margin_after)"/>%</span>
                                    </div>
                                </td>
                                <td>
                                    <span t-att-class="marginDeltaClass(seg.avg_margin_before, seg.avg_margin_after)">
                                        <t t-esc="formatPct(seg.margin_improvement)"/>
                                    </span>
                                </td>
                                <td class="dpad-td-center dpad-positive"><t t-esc="seg.increase"/></td>
                                <td class="dpad-td-center dpad-negative"><t t-esc="seg.decrease"/></td>
                                <td class="dpad-td-center dpad-neutral"><t t-esc="seg.hold"/></td>
                            </tr>
                        </t>
                    </tbody>
                </table>
            </div>
        </div>

        <!-- ═════════════════════════════════════════════════
             ROW 4 — TOP PRODUCTS PIPELINE
        ══════════════════════════════════════════════════ -->
        <div class="dpad-panel" t-if="hasProducts">
            <div class="dpad-panel__head">
                <span class="dpad-kicker">Opportunity Pipeline</span>
                <h2>Top products by sales impact</h2>
            </div>
            <div class="dpad-pipeline">
                <t t-foreach="topProducts" t-as="product" t-key="product.product_id + '_' + product.segment_name">
                    <div class="dpad-pipeline-card">
                        <div class="dpad-pipeline-card__top">
                            <div class="dpad-pipeline-card__rank">#<t t-esc="product_index + 1"/></div>
                            <span t-att-class="decisionClass(product.decision)">
                                <i t-att-class="'fa ' + decisionIcon(product.decision) + ' me-1'"/>
                                <t t-esc="decisionLabel(product.decision)"/>
                            </span>
                        </div>
                        <h4 class="dpad-pipeline-card__name"><t t-esc="product.product_name"/></h4>
                        <div class="dpad-pipeline-card__segment" t-if="product.segment_name">
                            <i class="fa fa-tag me-1"/><t t-esc="product.segment_name"/>
                        </div>
                        <div class="dpad-pipeline-card__bar">
                            <div t-att-style="'width:' + barWidth(product.revenue, maxRevenue)"/>
                        </div>
                        <div class="dpad-pipeline-card__stats">
                            <div>
                                <span>Revenue</span>
                                <strong><t t-esc="formatMoney(product.revenue)"/></strong>
                            </div>
                            <div>
                                <span>Sold</span>
                                <strong><t t-esc="formatNumber(product.qty_sold)"/></strong>
                            </div>
                            <div>
                                <span>AI Price</span>
                                <strong><t t-esc="formatMoney(product.suggested_price)"/></strong>
                            </div>
                            <div>
                                <span>Margin Δ</span>
                                <strong t-att-class="marginDeltaClass(product.margin_before, product.margin_after)">
                                    <t t-esc="formatNumber(product.margin_before)"/>% → <t t-esc="formatNumber(product.margin_after)"/>%
                                </strong>
                            </div>
                        </div>
                        <p class="dpad-pipeline-card__reason"><t t-esc="product.reason"/></p>
                    </div>
                </t>
            </div>
        </div>

        <!-- ═════════════════════════════════════════════════
             ROW 5 — IMPROVERS + AT RISK
        ══════════════════════════════════════════════════ -->
        <div class="dpad-row5">

            <!-- Top Margin Improvers -->
            <div class="dpad-panel" t-if="topImprovers.length">
                <div class="dpad-panel__head">
                    <span class="dpad-kicker">Margin Winners</span>
                    <h2>Biggest margin improvements</h2>
                </div>
                <div class="dpad-list">
                    <t t-foreach="topImprovers" t-as="row" t-key="row.product_id + '_' + row.segment_name">
                        <div class="dpad-list-row">
                            <div class="dpad-list-row__info">
                                <span class="dpad-list-row__name"><t t-esc="row.product_name"/></span>
                                <span class="dpad-list-row__seg" t-if="row.segment_name">
                                    <i class="fa fa-tag me-1"/><t t-esc="row.segment_name"/>
                                </span>
                            </div>
                            <div class="dpad-list-row__margin">
                                <span class="dpad-neutral"><t t-esc="formatNumber(row.margin_before)"/>%</span>
                                <i class="fa fa-arrow-right mx-2" style="font-size:10px; color:#9ba8bd;"/>
                                <span class="dpad-positive"><t t-esc="formatNumber(row.margin_after)"/>%</span>
                            </div>
                            <div class="dpad-positive dpad-list-row__delta">
                                +<t t-esc="formatNumber(row.margin_after - row.margin_before)"/>%
                            </div>
                        </div>
                    </t>
                </div>
            </div>

            <!-- At Risk Products -->
            <div class="dpad-panel dpad-risk-panel" t-if="atRisk.length">
                <div class="dpad-panel__head">
                    <span class="dpad-kicker">⚠ Attention Needed</span>
                    <h2>Low margin after AI</h2>
                </div>
                <div class="dpad-list">
                    <t t-foreach="atRisk" t-as="row" t-key="row.product_id + '_' + row.segment_name">
                        <div class="dpad-list-row">
                            <div class="dpad-list-row__info">
                                <span class="dpad-list-row__name"><t t-esc="row.product_name"/></span>
                                <span class="dpad-list-row__seg" t-if="row.segment_name">
                                    <i class="fa fa-tag me-1"/><t t-esc="row.segment_name"/>
                                </span>
                            </div>
                            <div class="dpad-list-row__margin">
                                <span class="dpad-neutral"><t t-esc="formatNumber(row.margin_before)"/>%</span>
                                <i class="fa fa-arrow-right mx-2" style="font-size:10px; color:#9ba8bd;"/>
                                <span class="dpad-negative"><t t-esc="formatNumber(row.margin_after)"/>%</span>
                            </div>
                            <div class="dpad-negative dpad-list-row__delta">
                                <t t-esc="formatNumber(row.margin_after)"/>% margin
                            </div>
                        </div>
                    </t>
                </div>
            </div>

        </div>

    </t>
</div>
</t>

</templates>